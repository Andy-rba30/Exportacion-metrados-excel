<Window x:Class="ExportacionMetrados.UI.MetradoEncofradoWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Metrado de encofrado"
        Width="680" SizeToContent="Height" ResizeMode="NoResize"
        MaxHeight="{x:Static SystemParameters.MaximizedPrimaryScreenHeight}"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        FontSize="12">

    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="12,4" />
            <Setter Property="MinWidth" Value="90" />
            <Setter Property="Margin" Value="4,0,0,0" />
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Margin" Value="0,3" />
        </Style>
        <Style TargetType="RadioButton">
            <Setter Property="Margin" Value="0,3" />
        </Style>
        <Style TargetType="GroupBox">
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>
    </Window.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="12">
            <TextBlock TextWrapping="Wrap" Foreground="Gray" Margin="0,0,0,8"
                       Text="Calcula el encofrado (m²) de cada elemento de concreto a partir de su geometría y de su contexto: cuenta las caras que se encofran según el tipo de elemento y descuenta las superficies en contacto con otros elementos de concreto (la viga que entra en la columna, la losa que apoya en la viga, el muro que recibe la losa...). El resultado se escribe en el parámetro &quot;Metrado - Encofrado (m²)&quot;, se tabula en Revit y se exporta a Excel con el detalle de cada descuento. En modelos grandes puede tardar algunos minutos." />

            <GroupBox Header="Elementos y caras que se encofran">
                <StackPanel>
                    <ItemsControl x:Name="LstReglas">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="170" />
                                        <ColumnDefinition Width="150" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <CheckBox Grid.Column="0" Content="{Binding Nombre}" IsChecked="{Binding Seleccionada, Mode=TwoWay}" ToolTip="{Binding Descripcion}" FontWeight="Bold" />
                                    <CheckBox Grid.Column="1" Content="Caras laterales" IsChecked="{Binding Laterales, Mode=TwoWay}" IsEnabled="{Binding Seleccionada}" ToolTip="{Binding Descripcion}" />
                                    <CheckBox Grid.Column="2" Content="Fondo (caras que miran hacia abajo)" IsChecked="{Binding Fondo, Mode=TwoWay}" IsEnabled="{Binding Seleccionada}" ToolTip="{Binding Descripcion}" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock TextWrapping="Wrap" Foreground="Gray" Margin="0,6,0,0"
                               Text="Las caras superiores (las que miran hacia arriba) no se encofran nunca. Las caras inclinadas más de 45° cuentan como laterales. Pase el ratón por cada elemento para ver qué se cuenta y qué se descuenta." />
                    <TextBlock Text="Fondo de las losas:" Margin="0,8,0,0" FontWeight="Bold" />
                    <RadioButton x:Name="RbFondoNivel" GroupName="FondoLosas" IsChecked="True">
                        <TextBlock TextWrapping="Wrap" Text="Contarlo, salvo en las losas apoyadas en el nivel más bajo del proyecto (losas sobre terreno, que no llevan encofrado de fondo)" />
                    </RadioButton>
                    <RadioButton x:Name="RbFondoSiempre" GroupName="FondoLosas" Content="Contarlo siempre" />
                    <RadioButton x:Name="RbFondoNunca" GroupName="FondoLosas" Content="No contarlo nunca (solo bordes de losa)" />
                </StackPanel>
            </GroupBox>

            <GroupBox Header="Contexto">
                <StackPanel>
                    <CheckBox x:Name="ChkDescontar" IsChecked="True">
                        <TextBlock TextWrapping="Wrap" Text="Descontar las superficies en contacto con otros elementos de concreto (vigas que entran en columnas o muros, losas que apoyan en vigas, columnas que atraviesan losas, zapatas vecinas...). Cuentan todos los elementos de concreto del modelo, aunque su grupo no esté marcado." />
                    </CheckBox>
                    <DockPanel Margin="20,3,0,0">
                        <TextBlock Text="Tolerancia de contacto (mm):" VerticalAlignment="Center" />
                        <TextBox x:Name="TxtTolerancia" Text="10" Width="60" Margin="8,0,0,0" HorizontalAlignment="Left" VerticalContentAlignment="Center"
                                 ToolTip="Separación máxima entre dos elementos para considerarlos en contacto. Absorbe las pequeñas holguras del modelado; una junta mayor (por ejemplo una junta de dilatación) deja las dos caras libres y ambas se encofran." />
                    </DockPanel>
                </StackPanel>
            </GroupBox>

            <GroupBox Header="Resultados en Revit">
                <StackPanel>
                    <CheckBox x:Name="ChkParametro" IsChecked="True"
                              Content="Escribir el resultado en el parámetro &quot;Metrado - Encofrado (m²)&quot; de cada elemento (se crea si falta)"
                              ToolTip="Parámetro compartido de ejemplar, vinculado a las categorías de concreto. Las tablas de Revit lo suman." />
                    <CheckBox x:Name="ChkPiel" IsChecked="True"
                              ToolTip="Por cada elemento metrado crea un modelo genérico auxiliar llamado &quot;Piel de encofrado - &lt;grupo&gt;&quot; con un sólido de 5 mm sobre cada cara que se encofra, al que se le resta exactamente lo que está en contacto con los vecinos: lo que se ve es lo que se metró. Cada grupo tiene su material y color (Vigas azul, Columnas rojo, Cimentaciones marrón, Losas verde, Muros morado), visibles en vistas sombreadas. Las caras curvas se pintan enteras, sin descuentos. Se reemplazan en cada cálculo y se quitan con &quot;Limpiar modelo&quot;; el metrado las ignora.">
                        <TextBlock TextWrapping="Wrap" Text="Crear la piel de encofrado de verificación: un sólido fino sobre cada cara que se encofra, descontados los contactos, con un color por elemento (modelos genéricos auxiliares; se reemplazan en cada cálculo)" />
                    </CheckBox>
                    <CheckBox x:Name="ChkTablas" IsChecked="True" Checked="ChkTablas_Changed" Unchecked="ChkTablas_Changed"
                              Content="Crear las tablas &quot;Metrado encofrado - Vigas / Columnas / Cimentaciones / Losas / Muros&quot;"
                              ToolTip="Elemento, Material, Cantidad y Encofrado (m²) con total, filtradas por &quot;Metrado - Material&quot; = CONCRETO y &quot;Metrado - Elemento&quot; = grupo (ejecute antes Metrado automático o Parámetros y filtros para que esos parámetros estén escritos). Columnas y muros, además por nivel." />
                    <StackPanel x:Name="PnlTablas" Margin="20,0,0,0">
                        <CheckBox x:Name="ChkTablaGeneral" IsChecked="True" Content="Crear además &quot;Metrado encofrado - General&quot; (todos los elementos, agrupados por &quot;Metrado - Elemento&quot;)" />
                        <CheckBox x:Name="ChkRegenerar" IsChecked="False" Content="Regenerar las tablas de encofrado que ya existan (se borran y se crean de nuevo)" />
                        <CheckBox x:Name="ChkAbrirTabla" IsChecked="True" Content="Abrir la primera tabla en Revit al terminar" />
                    </StackPanel>
                    <CheckBox x:Name="ChkSubproyectos" IsChecked="True"
                              Content="En modelos compartidos, reservar automáticamente los subproyectos que se modifican" />
                </StackPanel>
            </GroupBox>

            <GroupBox Header="Excel">
                <StackPanel>
                    <CheckBox x:Name="ChkExcel" IsChecked="True" Checked="ChkExcel_Changed" Unchecked="ChkExcel_Changed"
                              Content="Exportar a Excel: resumen por elemento, tipo y nivel, las tablas de Revit y el detalle elemento por elemento" />
                    <StackPanel x:Name="PnlExcel" Margin="20,0,0,0">
                        <CheckBox x:Name="ChkContactos" IsChecked="True" Content="Incluir la hoja &quot;Contactos&quot;: qué superficie se descontó de cada elemento y con qué elemento vecino" />
                        <CheckBox x:Name="ChkAbrir" IsChecked="True" Content="Ofrecer abrir el archivo al terminar" />
                        <DockPanel Margin="0,6,0,0">
                            <TextBlock Text="Archivo:" VerticalAlignment="Center" Margin="0,0,6,0" />
                            <Button DockPanel.Dock="Right" Content="Examinar..." Click="BtnExaminar_Click" />
                            <TextBox x:Name="TxtRuta" VerticalContentAlignment="Center" />
                        </DockPanel>
                    </StackPanel>
                </StackPanel>
            </GroupBox>

            <DockPanel Margin="0,4,0,0">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Content="Cancelar" IsCancel="True" />
                    <Button Content="Calcular encofrado" IsDefault="True" Click="BtnCalcular_Click" FontWeight="Bold" />
                </StackPanel>
                <TextBlock x:Name="TxtContrato" Foreground="Gray" VerticalAlignment="Center"
                           ToolTip="Versión del contrato ARBA-comun (parámetros compartidos y cinta) con la que se compiló el plugin." />
            </DockPanel>
        </StackPanel>
    </ScrollViewer>
</Window>
