<Window x:Class="ExportacionMetrados.UI.MetradoAutomaticoWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Metrado automático de concreto y acero"
        Width="560" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        FontSize="12">

    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="12,4" />
            <Setter Property="MinWidth" Value="90" />
            <Setter Property="Margin" Value="4,0,0,0" />
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Margin" Value="0,3" />
        </Style>
    </Window.Resources>

    <StackPanel Margin="12">
        <TextBlock TextWrapping="Wrap" Foreground="Gray" Margin="0,0,0,8"
                   Text="Recorre el modelo y calcula el volumen de concreto por elemento, nivel y tipo, y el acero de refuerzo por elemento anfitrión, nivel y diámetro. No necesita tablas de planificación." />

        <GroupBox Header="Elementos de concreto a metrar" Padding="8,4">
            <ItemsControl x:Name="LstCategorias">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="3" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <CheckBox Content="{Binding Nombre}" IsChecked="{Binding Seleccionada, Mode=TwoWay}" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </GroupBox>

        <GroupBox Header="Opciones" Padding="8,4" Margin="0,8,0,0">
            <StackPanel>
                <CheckBox x:Name="ChkSoloConcreto" Content="Solo elementos con material de concreto (omite acero estructural, madera, etc.)" IsChecked="True" />
                <CheckBox x:Name="ChkAcero" Content="Incluir acero de refuerzo (barras alojadas en los elementos seleccionados)" IsChecked="True" />
                <CheckBox x:Name="ChkDetalle" Content="Incluir hojas de detalle elemento por elemento" IsChecked="True" />
                <CheckBox x:Name="ChkAbrir" Content="Ofrecer abrir el archivo al terminar" IsChecked="True" />
                <DockPanel Margin="0,4,0,0">
                    <TextBlock Text="Densidad del acero (kg/m³):" VerticalAlignment="Center" Margin="0,0,6,0" />
                    <TextBox x:Name="TxtDensidad" Text="7850" Width="80" HorizontalAlignment="Left" VerticalContentAlignment="Center" />
                </DockPanel>
            </StackPanel>
        </GroupBox>

        <DockPanel Margin="0,10,0,0">
            <TextBlock Text="Archivo:" VerticalAlignment="Center" Margin="0,0,6,0" />
            <Button DockPanel.Dock="Right" Content="Examinar..." Click="BtnExaminar_Click" />
            <TextBox x:Name="TxtRuta" VerticalContentAlignment="Center" />
        </DockPanel>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Cancelar" IsCancel="True" />
            <Button Content="Calcular y exportar" IsDefault="True" Click="BtnExportar_Click" FontWeight="Bold" />
        </StackPanel>
    </StackPanel>
</Window>
