<Window x:Class="ExportacionMetrados.UI.MetradoAutomaticoWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Metrado automático de concreto y acero"
        Width="600" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        FontSize="12">

    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="12,4" />
            <Setter Property="MinWidth" Value="90" />
            <Setter Property="Margin" Value="4,0,0,0" />
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Margin" Value="0,3" />
        </Style>
        <Style TargetType="GroupBox">
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>
    </Window.Resources>

    <StackPanel Margin="12">
        <TextBlock TextWrapping="Wrap" Foreground="Gray" Margin="0,0,0,8"
                   Text="Crea en el proyecto las tablas de planificación de metrado (una de concreto y una de acero por cada tipo de elemento) y, si lo desea, las exporta a Excel en la misma operación." />

        <GroupBox Header="Elementos a metrar">
            <ItemsControl x:Name="LstCategorias">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="3" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <CheckBox Content="{Binding Nombre}" IsChecked="{Binding Seleccionada, Mode=TwoWay}" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </GroupBox>

        <GroupBox Header="Tablas en Revit">
            <StackPanel>
                <CheckBox x:Name="ChkAceroEstructural" Content="Separar en tablas aparte los elementos metálicos (acero estructural), metrados por peso" IsChecked="True" />
                <DockPanel Margin="20,3,0,3">
                    <TextBlock Text="Densidad del acero al carbono de los perfiles (kg/m³):" VerticalAlignment="Center" />
                    <TextBox x:Name="TxtDensidadPerfiles" Text="7850" Width="70" Margin="8,0,0,0" HorizontalAlignment="Left" VerticalContentAlignment="Center"
                             ToolTip="Peso del perfil = longitud × área de sección × densidad. Se escribe en el parámetro &quot;Metrado - Peso (kg)&quot; de cada viga o columna metálica." />
                </DockPanel>
                <CheckBox x:Name="ChkConservarMaterial" Content="Conservar la clasificación &quot;Metrado - Material&quot; ya escrita en los elementos" IsChecked="False" />
                <CheckBox x:Name="ChkParticiones" Content="Rellenar la partición vacía del acero según el elemento anfitrión (VIGAS, COLUMNAS, CIMIENTOS, LOSAS, MUROS)" IsChecked="True" />
                <CheckBox x:Name="ChkSobrescribirParticiones" Content="Sobrescribir también las particiones que ya tengan texto" IsChecked="False" Margin="20,3,0,3" />
                <CheckBox x:Name="ChkAcero" Content="Crear las tablas de acero de refuerzo por elemento" IsChecked="True" />
                <CheckBox x:Name="ChkAceroGeneral" Content="Crear además una tabla general de acero de refuerzo (partición → elemento → tipo)" IsChecked="True" />
                <CheckBox x:Name="ChkRegenerar" IsChecked="False">
                    <TextBlock TextWrapping="Wrap" Text="Regenerar las tablas que ya existan (se borran y se crean de nuevo; se pierden columnas añadidas a mano y su ubicación en planos)" />
                </CheckBox>
                <DockPanel Margin="0,3">
                    <CheckBox x:Name="ChkFiltrarMaterial" Content="Respaldo: texto que identifica los materiales de concreto:" IsChecked="True" VerticalAlignment="Center" />
                    <TextBox x:Name="TxtMaterial" Text="Concreto" Width="140" Margin="8,0,0,0" HorizontalAlignment="Left" VerticalContentAlignment="Center" />
                </DockPanel>
                <DockPanel Margin="0,3">
                    <TextBlock Text="Parámetro de peso unitario de la barra (kg/m):" VerticalAlignment="Center" />
                    <TextBox x:Name="TxtParametroPeso" Text="Bar Mass per Unit Length" Width="200" Margin="8,0,0,0" HorizontalAlignment="Left" VerticalContentAlignment="Center" />
                </DockPanel>
                <CheckBox x:Name="ChkAbrirTabla" Content="Abrir la primera tabla en Revit al terminar" IsChecked="True" />
            </StackPanel>
        </GroupBox>

        <GroupBox Header="Excel">
            <StackPanel>
                <CheckBox x:Name="ChkExcel" Content="Exportar también a Excel en la misma operación" IsChecked="True" Checked="ChkExcel_Changed" Unchecked="ChkExcel_Changed" />
                <StackPanel x:Name="PnlExcel" Margin="20,0,0,0">
                    <CheckBox x:Name="ChkSoloConcreto" Content="Resumen: solo elementos con material de concreto" IsChecked="True" />
                    <CheckBox x:Name="ChkDetalle" Content="Incluir hojas de detalle elemento por elemento" IsChecked="True" />
                    <CheckBox x:Name="ChkAbrir" Content="Ofrecer abrir el archivo al terminar" IsChecked="True" />
                    <DockPanel Margin="0,3">
                        <TextBlock Text="Densidad del acero si falta el parámetro de peso (kg/m³):" VerticalAlignment="Center" />
                        <TextBox x:Name="TxtDensidad" Text="7850" Width="70" Margin="8,0,0,0" HorizontalAlignment="Left" VerticalContentAlignment="Center" />
                    </DockPanel>
                    <DockPanel Margin="0,6,0,0">
                        <TextBlock Text="Archivo:" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <Button DockPanel.Dock="Right" Content="Examinar..." Click="BtnExaminar_Click" />
                        <TextBox x:Name="TxtRuta" VerticalContentAlignment="Center" />
                    </DockPanel>
                </StackPanel>
            </StackPanel>
        </GroupBox>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,4,0,0">
            <Button Content="Cancelar" IsCancel="True" />
            <Button Content="Generar metrado" IsDefault="True" Click="BtnExportar_Click" FontWeight="Bold" />
        </StackPanel>
    </StackPanel>
</Window>
