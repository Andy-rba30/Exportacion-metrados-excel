<Window x:Class="ExportacionMetrados.UI.SeleccionTablasWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Exportar metrados a Excel"
        Width="720" Height="560" MinWidth="600" MinHeight="460"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        FontSize="12">

    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="12,4" />
            <Setter Property="MinWidth" Value="90" />
            <Setter Property="Margin" Value="4,0,0,0" />
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Margin" Value="0,3" />
        </Style>
    </Window.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Filtro y selección rápida -->
        <DockPanel Grid.Row="0" Margin="0,0,0,8">
            <TextBlock Text="Buscar:" VerticalAlignment="Center" Margin="0,0,6,0" />
            <Button DockPanel.Dock="Right" Content="Ninguna" Click="BtnNinguna_Click" />
            <Button DockPanel.Dock="Right" Content="Todas" Click="BtnTodas_Click" />
            <TextBox x:Name="TxtFiltro" TextChanged="TxtFiltro_TextChanged" VerticalContentAlignment="Center" Margin="0,0,8,0" />
        </DockPanel>

        <!-- Lista de tablas -->
        <ListView Grid.Row="1" x:Name="LstTablas" SelectionMode="Extended" MouseDoubleClick="LstTablas_MouseDoubleClick">
            <ListView.View>
                <GridView>
                    <GridViewColumn Width="36">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <CheckBox IsChecked="{Binding Seleccionada, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                          HorizontalAlignment="Center" Margin="0" />
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Header="Tabla" Width="340" DisplayMemberBinding="{Binding Nombre}" />
                    <GridViewColumn Header="Categoría" Width="160" DisplayMemberBinding="{Binding Categoria}" />
                    <GridViewColumn Header="Tipo" Width="150" DisplayMemberBinding="{Binding Tipo}" />
                </GridView>
            </ListView.View>
        </ListView>

        <!-- Opciones -->
        <GroupBox Grid.Row="2" Header="Opciones" Margin="0,10,0,0" Padding="8,4">
            <UniformGrid Columns="2">
                <CheckBox x:Name="ChkTitulo" Content="Incluir el nombre de la tabla como título" IsChecked="True" />
                <CheckBox x:Name="ChkEncabezados" Content="Incluir encabezados de columna" IsChecked="True" />
                <CheckBox x:Name="ChkNumeros" Content="Convertir valores numéricos (conserva la unidad)" IsChecked="True" />
                <CheckBox x:Name="ChkFormato" Content="Aplicar formato (negrita, bordes, anchos)" IsChecked="True" />
                <CheckBox x:Name="ChkAbrir" Content="Ofrecer abrir el archivo al terminar" IsChecked="True" />
            </UniformGrid>
        </GroupBox>

        <!-- Archivo de salida -->
        <DockPanel Grid.Row="3" Margin="0,10,0,0">
            <TextBlock Text="Archivo:" VerticalAlignment="Center" Margin="0,0,6,0" />
            <Button DockPanel.Dock="Right" Content="Examinar..." Click="BtnExaminar_Click" />
            <TextBox x:Name="TxtRuta" VerticalContentAlignment="Center" />
        </DockPanel>

        <!-- Botones -->
        <DockPanel Grid.Row="4" Margin="0,12,0,0">
            <TextBlock x:Name="TxtResumen" VerticalAlignment="Center" Foreground="Gray" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancelar" IsCancel="True" />
                <Button x:Name="BtnExportar" Content="Exportar" IsDefault="True" Click="BtnExportar_Click" FontWeight="Bold" />
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
