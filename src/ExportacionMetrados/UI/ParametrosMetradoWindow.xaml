<Window x:Class="ExportacionMetrados.UI.ParametrosMetradoWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Parámetros, filtros y tablas propias del metrado"
        Width="760" Height="640" MinWidth="640" MinHeight="480"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        FontSize="12">

    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="12,4" />
            <Setter Property="MinWidth" Value="90" />
            <Setter Property="Margin" Value="4,0,0,0" />
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Margin" Value="0,3" />
        </Style>
        <Style TargetType="GroupBox">
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>
    </Window.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TabControl x:Name="Pestanas" Grid.Row="0" SelectionChanged="Pestanas_SelectionChanged">

            <!-- ============================================================ -->
            <!-- Paso 1: parámetros y filtros, sin tablas                      -->
            <!-- ============================================================ -->
            <TabItem Header="  1. Parámetros y filtros (sin tablas)  ">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="8">
                        <TextBlock TextWrapping="Wrap" Foreground="Gray" Margin="0,0,0,8"
                                   Text="Escribe en el modelo los mismos parámetros que el metrado automático (&quot;Metrado - Material&quot;, &quot;Metrado - Elemento&quot;, &quot;Metrado - Peso (kg)&quot;, la partición MAN y &quot;ARBA - Origen&quot; del refuerzo) y crea los filtros de vista por colores, pero NO crea ninguna tabla. Después puede cambiar a mano &quot;Metrado - Material&quot; y &quot;Metrado - Elemento&quot; en los elementos o armaduras que quiera (por ejemplo ESCALERAS, o CONCRETO F'C 280) y, en la pestaña 2, crear tablas propias con esos valores, aparte de las predeterminadas." />

                        <GroupBox Header="Elementos a clasificar">
                            <ItemsControl x:Name="LstCategorias">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Columns="3" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <CheckBox Content="{Binding Nombre}" IsChecked="{Binding Seleccionada, Mode=TwoWay}" ToolTip="{Binding Descripcion}" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </GroupBox>

                        <GroupBox Header="Parámetros">
                            <StackPanel>
                                <CheckBox x:Name="ChkConservarMaterial" IsChecked="True"
                                          ToolTip="Sin marcar, el plugin vuelve a clasificar todos los elementos (CONCRETO / ACERO ESTRUCTURAL / MADERA / OTRO) y pisa cualquier texto propio que haya escrito en ese parámetro.">
                                    <TextBlock TextWrapping="Wrap" Text="Conservar &quot;Metrado - Material&quot; ya escrito: solo rellenar los elementos que lo tengan vacío (respeta los textos propios)" />
                                </CheckBox>
                                <CheckBox x:Name="ChkConservarElemento" IsChecked="True"
                                          ToolTip="Sin marcar, el plugin vuelve a escribir el grupo (VIGAS, COLUMNAS, LOSAS...) en todos los elementos y armaduras y pisa cualquier texto propio (ESCALERAS...) que haya escrito en ese parámetro. El metrado automático siempre lo reescribe.">
                                    <TextBlock TextWrapping="Wrap" Text="Conservar &quot;Metrado - Elemento&quot; ya escrito: solo rellenar los elementos y armaduras que lo tengan vacío (respeta los textos propios)" />
                                </CheckBox>
                                <CheckBox x:Name="ChkRefuerzo" IsChecked="True"
                                          Content="Incluir el acero de refuerzo (&quot;Metrado - Elemento&quot;, partición y &quot;Metrado - Peso (kg)&quot; de las armaduras)" />
                                <CheckBox x:Name="ChkParticiones" IsChecked="True" Margin="20,3,0,3">
                                    <TextBlock TextWrapping="Wrap" Text="Rellenar la partición vacía del acero que no creó un add-in ARBA con la forma del contrato: CATEGORIA - MAN-marca del anfitrión (VIGAS - MAN-V1, CIMIENTOS - MAN-Z3...) y &quot;ARBA - Origen&quot; = MANUAL" />
                                </CheckBox>
                                <CheckBox x:Name="ChkSobrescribirParticiones" Content="Sobrescribir también las particiones que ya tengan texto (las de los add-ins ARBA nunca se tocan)" IsChecked="False" Margin="40,3,0,3" />
                            </StackPanel>
                        </GroupBox>

                        <GroupBox Header="Filtros de vista y modelo compartido">
                            <StackPanel>
                                <CheckBox x:Name="ChkFiltrosVista" IsChecked="True"
                                          ToolTip="Crea en el proyecto los filtros &quot;Metrado - Concreto - Vigas&quot;, &quot;Metrado - Acero estructural - Columnas&quot;, &quot;Metrado - Refuerzo - LOSAS&quot;, etc., cada uno con un color distinto, y los aplica con relleno sólido a la vista activa o, si no los admite, a otra vista 3D abierta o a la 3D predeterminada. Son los mismos filtros que crea el metrado automático.">
                                    <TextBlock TextWrapping="Wrap" Text="Crear los filtros de vista por colores (Visibilidad/Gráficos): un color por elemento de concreto, de acero estructural y de refuerzo; se aplican a la vista activa" />
                                </CheckBox>
                                <CheckBox x:Name="ChkSubproyectos" IsChecked="True"
                                          Content="En modelos compartidos, reservar automáticamente los subproyectos que se modifican"
                                          ToolTip="Evita el aviso de Revit &quot;You are trying to checkout a large number of elements&quot;. Quedan reservados hasta que sincronice con central." />
                            </StackPanel>
                        </GroupBox>

                        <GroupBox Header="Cálculo del peso en kg (parámetro &quot;Metrado - Peso (kg)&quot;)">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" Margin="0,3" VerticalAlignment="Center"
                                           Text="Parámetro de peso por metro del tipo de barra (kg/m):" />
                                <TextBox Grid.Row="0" Grid.Column="1" x:Name="TxtParametroPeso" Text="Bar Mass per Unit Length" Width="160" Margin="8,3,0,3"
                                         HorizontalAlignment="Left" VerticalContentAlignment="Center"
                                         ToolTip="Nombre del parámetro del tipo de barra que contiene el peso por metro. Si no existe, el peso de la armadura se calcula con π·d²/4 × densidad del acero de refuerzo." />

                                <TextBlock Grid.Row="1" Grid.Column="0" Margin="0,3" VerticalAlignment="Center"
                                           Text="Densidad del acero de refuerzo si falta ese parámetro (kg/m³):" />
                                <TextBox Grid.Row="1" Grid.Column="1" x:Name="TxtDensidad" Text="7850" Width="70" Margin="8,3,0,3"
                                         HorizontalAlignment="Left" VerticalContentAlignment="Center" />

                                <TextBlock Grid.Row="2" Grid.Column="0" Margin="0,3" VerticalAlignment="Center"
                                           Text="Densidad del acero al carbono de los perfiles metálicos (kg/m³):" />
                                <TextBox Grid.Row="2" Grid.Column="1" x:Name="TxtDensidadPerfiles" Text="7850" Width="70" Margin="8,3,0,3"
                                         HorizontalAlignment="Left" VerticalContentAlignment="Center"
                                         ToolTip="Peso del perfil = longitud × área de sección × densidad. Se escribe en &quot;Metrado - Peso (kg)&quot; de cada viga o columna metálica." />
                            </Grid>
                        </GroupBox>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ============================================================ -->
            <!-- Paso 2: tablas a partir de los valores de los parámetros      -->
            <!-- ============================================================ -->
            <TabItem Header="  2. Tablas desde los parámetros  ">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" TextWrapping="Wrap" Foreground="Gray" Margin="0,0,0,8"
                               Text="Lee los valores que tienen &quot;Metrado - Material&quot; y &quot;Metrado - Elemento&quot; en los elementos y armaduras del modelo y crea una tabla de planificación por cada combinación marcada, filtrada por esos valores exactos, sin reescribir ningún parámetro. Las combinaciones que ya cubren las tablas predeterminadas del metrado automático aparecen sin marcar; las propias (textos que usted escribió), marcadas. Si una combinación abarca varias categorías de Revit se crea una tabla por categoría. Con &quot;Actualizar filtros&quot; se crean o actualizan los filtros de vista por colores en vez de las tablas: los predeterminados y uno nuevo por cada combinación propia marcada." />

                    <DockPanel Grid.Row="1" Margin="0,0,0,6">
                        <Button DockPanel.Dock="Right" Content="Ninguna" Click="BtnNinguna_Click" />
                        <Button DockPanel.Dock="Right" Content="Todas" Click="BtnTodas_Click" />
                        <Button DockPanel.Dock="Right" Content="Solo propias" Click="BtnPropias_Click" />
                        <TextBlock x:Name="TxtEstadoCombinaciones" VerticalAlignment="Center" Foreground="Gray" TextWrapping="Wrap" />
                    </DockPanel>

                    <ListView Grid.Row="2" x:Name="LstCombinaciones" SelectionMode="Extended" MouseDoubleClick="LstCombinaciones_MouseDoubleClick">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Width="32">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <CheckBox IsChecked="{Binding Seleccionada, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                      HorizontalAlignment="Center" Margin="0" />
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="Tipo" Width="70" DisplayMemberBinding="{Binding TipoTexto}" />
                                <GridViewColumn Header="Metrado - Material" Width="130" DisplayMemberBinding="{Binding MaterialTexto}" />
                                <GridViewColumn Header="Metrado - Elemento" Width="120" DisplayMemberBinding="{Binding ElementoTexto}" />
                                <GridViewColumn Header="Categorías" Width="150" DisplayMemberBinding="{Binding NombresCategorias}" />
                                <GridViewColumn Header="N.º" Width="45" DisplayMemberBinding="{Binding NumeroElementos}" />
                                <GridViewColumn Header="Origen" Width="95" DisplayMemberBinding="{Binding OrigenTexto}" />
                                <GridViewColumn Header="Tabla que se crea" Width="260" DisplayMemberBinding="{Binding NombresTablas}" />
                            </GridView>
                        </ListView.View>
                    </ListView>

                    <StackPanel Grid.Row="3" Margin="0,8,0,0">
                        <CheckBox x:Name="ChkRegenerar" IsChecked="False"
                                  Content="Regenerar las tablas que ya existan con ese nombre (se borran y se crean de nuevo; se pierden columnas añadidas a mano)" />
                        <CheckBox x:Name="ChkAbrirTabla" Content="Abrir la primera tabla en Revit al terminar" IsChecked="True" />
                    </StackPanel>
                </Grid>
            </TabItem>
        </TabControl>

        <DockPanel Grid.Row="1" Margin="0,10,0,0">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Content="Cancelar" IsCancel="True" />
                <Button x:Name="BtnFiltros" Content="Actualizar filtros" Click="BtnFiltros_Click" MinWidth="140" Visibility="Collapsed"
                        ToolTip="Crea o actualiza los filtros de vista por colores predeterminados (los de los elementos marcados en la pestaña 1) y crea un filtro nuevo por cada combinación propia marcada (&quot;Metrado - Concreto - ESCALERAS&quot;, &quot;Metrado - Refuerzo - ESCALERAS&quot;...), con los mismos valores exactos que su tabla, aplicados a la vista activa. No crea tablas ni reescribe parámetros." />
                <Button x:Name="BtnEjecutar" Content="Escribir parámetros y filtros" IsDefault="True" Click="BtnEjecutar_Click" FontWeight="Bold" MinWidth="200" />
            </StackPanel>
            <TextBlock x:Name="TxtContrato" Foreground="Gray" VerticalAlignment="Center"
                       ToolTip="Versión del contrato ARBA-comun (parámetros compartidos, partición del acero y cinta) con la que se compiló el plugin." />
        </DockPanel>
    </Grid>
</Window>
