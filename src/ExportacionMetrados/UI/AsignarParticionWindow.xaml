<Window x:Class="ExportacionMetrados.UI.AsignarParticionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Asignar partición al acero de refuerzo"
        Width="520" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" FontSize="12">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="12,4" />
            <Setter Property="MinWidth" Value="90" />
            <Setter Property="Margin" Value="4,0,0,0" />
        </Style>
        <Style TargetType="RadioButton">
            <Setter Property="Margin" Value="0,3" />
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Margin" Value="0,3" />
        </Style>
    </Window.Resources>
    <StackPanel Margin="12">
        <TextBlock x:Name="TxtEstado" TextWrapping="Wrap" Foreground="Gray" Margin="0,0,0,8" />

        <GroupBox Header="Aplicar a" Padding="8,4">
            <StackPanel>
                <RadioButton x:Name="RbSeleccion" GroupName="AplicarA" Content="La selección actual (elementos anfitriones y/o armaduras)" IsChecked="True" />
                <RadioButton x:Name="RbElegir" GroupName="AplicarA" Content="Elegir elementos en pantalla ahora" />
                <RadioButton x:Name="RbTodo" GroupName="AplicarA" Content="Todo el modelo" />
            </StackPanel>
        </GroupBox>

        <GroupBox Header="Texto de la partición" Padding="8,4" Margin="0,8,0,0">
            <StackPanel>
                <RadioButton x:Name="RbAutomatica" GroupName="Texto" Content="Según la categoría del anfitrión: VIGAS, COLUMNAS, CIMIENTOS, LOSAS, MUROS" IsChecked="True" />
                <DockPanel>
                    <RadioButton x:Name="RbPersonalizada" GroupName="Texto" Content="Texto propio:" VerticalAlignment="Center" Checked="RbTexto_Changed" Unchecked="RbTexto_Changed" />
                    <TextBox x:Name="TxtPersonalizada" Margin="8,0,0,0" VerticalContentAlignment="Center" IsEnabled="False" GotFocus="TxtPersonalizada_GotFocus" />
                </DockPanel>
                <CheckBox x:Name="ChkSobrescribir" Content="Sobrescribir las particiones que ya tengan texto" IsChecked="True" Margin="0,8,0,0" />
            </StackPanel>
        </GroupBox>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Cancelar" IsCancel="True" />
            <Button Content="Asignar" IsDefault="True" Click="BtnAsignar_Click" FontWeight="Bold" />
        </StackPanel>
    </StackPanel>
</Window>
