<Window x:Class="ExportacionMetrados.UI.LimpiarModeloWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Limpiar modelo"
        Width="620" SizeToContent="Height" MinWidth="520"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        FontSize="12">

    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="12,4" />
            <Setter Property="MinWidth" Value="90" />
            <Setter Property="Margin" Value="4,0,0,0" />
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Margin" Value="0,6" />
        </Style>
    </Window.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" TextWrapping="Wrap" Foreground="Gray" Margin="0,0,0,8"
                   Text="Quita del proyecto lo que deja el plugin de metrados. Marque lo que quiera limpiar. Lo que escribieron los add-ins ARBA de armado (partición, origen, código, partida, pesos de rejillas y ángulos) se respeta, salvo que borre los parámetros. Se puede deshacer con Ctrl+Z." />

        <GroupBox Grid.Row="1" Header="Qué limpiar" Padding="8,4">
            <StackPanel>
                <CheckBox x:Name="ChkFiltros" IsChecked="True">
                    <TextBlock TextWrapping="Wrap" Text="Eliminar los filtros de vista del plugin (&quot;Metrado - Concreto - Vigas&quot;, &quot;Metrado - Refuerzo - LOSAS&quot;, los propios...). Se quitan también de las vistas que los usaban." />
                </CheckBox>
                <CheckBox x:Name="ChkTablas" IsChecked="True">
                    <TextBlock TextWrapping="Wrap" Text="Eliminar las tablas de planificación creadas por el plugin (todas las que empiezan por &quot;Metrado &quot;: concreto, acero estructural, acero, encofrado, generales y propias). Si están en planos, desaparecen de ellos." />
                </CheckBox>
                <CheckBox x:Name="ChkValores" IsChecked="False">
                    <TextBlock TextWrapping="Wrap" Text="Limpiar los valores que escribe el plugin: &quot;Metrado - Material&quot;, &quot;Metrado - Elemento&quot;, &quot;Metrado - Peso (kg)&quot; y &quot;Metrado - Encofrado (m²)&quot; en elementos y refuerzo, y la partición + &quot;ARBA - Origen&quot; del refuerzo que particionó el plugin (MAN / MANUAL). Los parámetros se conservan." />
                </CheckBox>
                <CheckBox x:Name="ChkParametros" IsChecked="False"
                          ToolTip="Quita del proyecto el vínculo de los ocho parámetros compartidos del contrato ARBA-comun (ARBA - Origen, ARBA - Código, ARBA - Anfitrión, Metrado - Partida, Metrado - Material, Metrado - Peso (kg), Metrado - Pernos (und), Metrado - Elemento) y de Metrado - Encofrado (m²). Al quitarlos se pierden todos sus valores, incluidos los de los add-ins ARBA; cualquier add-in ARBA o este plugin los vuelve a crear al ejecutarse.">
                    <TextBlock TextWrapping="Wrap" Text="Borrar los parámetros que crea el plugin: dejan de salir en Propiedades (los del contrato ARBA-comun y &quot;Metrado - Encofrado (m²)&quot;). Se pierden todos sus valores, también los escritos por los add-ins ARBA." />
                </CheckBox>
            </StackPanel>
        </GroupBox>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="Cancelar" IsCancel="True" />
            <Button x:Name="BtnLimpiar" Content="Limpiar" IsDefault="True" Click="BtnLimpiar_Click" FontWeight="Bold" MinWidth="120" />
        </StackPanel>
    </Grid>
</Window>
