<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Plugin de Revit: Exportación de metrados (tablas de planificación) a Excel.

    Compilar:  dotnet build -c Release -p:RevitVersion=2027
    La versión de Revit se cambia con la propiedad RevitVersion (2021...2027).
    El TargetFramework se elige según la versión:
      2021-2024 -> net48          (.NET Framework 4.8)
      2025-2026 -> net8.0-windows (.NET 8)
      2027+     -> net10.0-windows (.NET 10)
    Si su Revit usa otro runtime, fuércelo: -p:TargetFramework=net8.0-windows

    Código común ARBA-comun (contrato de parámetros, partición, cinta): submódulo git en external/ARBA-comun,
    compilado como fuente dentro de este ensamblado por Arba.Comun.props (nunca como DLL compartida).
    Clonar con: git clone &#45;&#45;recurse-submodules ... (o git submodule update &#45;&#45;init)
  -->

  <PropertyGroup>
    <RevitVersion Condition="'$(RevitVersion)' == ''">2027</RevitVersion>
    <TargetFramework Condition="'$(TargetFramework)' == '' AND $(RevitVersion) &lt; 2025">net48</TargetFramework>
    <TargetFramework Condition="'$(TargetFramework)' == '' AND $(RevitVersion) &gt;= 2025 AND $(RevitVersion) &lt; 2027">net8.0-windows</TargetFramework>
    <TargetFramework Condition="'$(TargetFramework)' == '' AND $(RevitVersion) &gt;= 2027">net10.0-windows</TargetFramework>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <UseWPF>true</UseWPF>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <NoWarn>$(NoWarn);CS0618;CS0612;MSB3277</NoWarn>
    <PlatformTarget>x64</PlatformTarget>
    <RootNamespace>ExportacionMetrados</RootNamespace>
    <AssemblyName>ExportacionMetrados</AssemblyName>
    <Version>1.0.0</Version>
    <Authors>DBR Soluciones</Authors>
    <Product>Exportación de Metrados a Excel</Product>
    <Description>Exporta las tablas de planificación (metrados) de Revit a un libro de Excel.</Description>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <DefineConstants>$(DefineConstants);REVIT$(RevitVersion)</DefineConstants>
    <RevitInstallDir>$(ProgramW6432)\Autodesk\Revit $(RevitVersion)</RevitInstallDir>
    <AddinsDir>$(AppData)\Autodesk\Revit\Addins\$(RevitVersion)</AddinsDir>
  </PropertyGroup>

  <!-- Código común ARBA-comun (clases internal en el namespace Arba.Comun, contrato.json enlazado). -->
  <Import Project="../../external/ARBA-comun/Arba.Comun.props" />

  <PropertyGroup>
    <!--
      Sin Revit instalado (otro equipo, Linux, integración continua) la API se toma de los paquetes
      Nice3point.Revit.Api.* de NuGet, los mismos que usa ARBA-comun para comprobar su compilación.
      Se puede forzar con -p:RevitApiDesdeNuGet=true. Los ensamblados no se copian a la salida.
    -->
    <RevitApiDesdeNuGet Condition="'$(RevitApiDesdeNuGet)' == '' AND !Exists('$(RevitInstallDir)\RevitAPI.dll')">true</RevitApiDesdeNuGet>
  </PropertyGroup>

  <ItemGroup Condition="'$(RevitApiDesdeNuGet)' != 'true'">
    <!-- Referencias a la API de Revit instalada (no se copian a la salida). -->
    <Reference Include="RevitAPI">
      <HintPath>$(RevitInstallDir)\RevitAPI.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="RevitAPIUI">
      <HintPath>$(RevitInstallDir)\RevitAPIUI.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup Condition="'$(RevitApiDesdeNuGet)' == 'true'">
    <PackageReference Include="Nice3point.Revit.Api.RevitAPI" Version="$(RevitVersion).*" ExcludeAssets="runtime" />
    <PackageReference Include="Nice3point.Revit.Api.RevitAPIUI" Version="$(RevitVersion).*" ExcludeAssets="runtime" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net48'">
    <Reference Include="PresentationCore" />
    <Reference Include="PresentationFramework" />
    <Reference Include="WindowsBase" />
    <Reference Include="System.Xaml" />
    <Reference Include="System.Windows.Forms" />
  </ItemGroup>

  <ItemGroup>
    <!-- Generación del archivo .xlsx sin depender de Excel instalado. -->
    <PackageReference Include="ClosedXML" Version="0.102.3" />
  </ItemGroup>

  <ItemGroup>
    <None Include="ExportacionMetrados.addin">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <Resource Include="Resources\icono32.png" />
    <Resource Include="Resources\icono16.png" />
    <Resource Include="Resources\metrado32.png" />
    <Resource Include="Resources\metrado16.png" />
    <Resource Include="Resources\particion32.png" />
    <Resource Include="Resources\particion16.png" />
  </ItemGroup>

  <!--
    Tras compilar, copia el plugin a la carpeta de add-ins del usuario para que
    Revit lo cargue al iniciar. Se puede desactivar con -p:DeployToRevit=false
  -->
  <Target Name="DeployToRevit" AfterTargets="Build" Condition="'$(DeployToRevit)' != 'false' AND '$(OS)' == 'Windows_NT'">
    <ItemGroup>
      <OutputFiles Include="$(OutDir)**\*.*" Exclude="$(OutDir)**\*.addin" />
    </ItemGroup>
    <MakeDir Directories="$(AddinsDir)\ExportacionMetrados" />
    <Copy SourceFiles="@(OutputFiles)" DestinationFiles="@(OutputFiles->'$(AddinsDir)\ExportacionMetrados\%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
    <Copy SourceFiles="$(OutDir)ExportacionMetrados.addin" DestinationFolder="$(AddinsDir)" SkipUnchangedFiles="true" />
    <Message Importance="high" Text="Plugin desplegado en $(AddinsDir)" />
  </Target>

</Project>
